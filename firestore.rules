rules_version = '2';
// ERGS AI – AI in School: A Teacher's Guide (Firebase project: ergs-ai)
service cloud.firestore {
  match /databases/{database}/documents {
    // Content is encrypted with the staff password, so anyone may read; only the editor may write.
    function nlEditor() { return request.auth != null && request.auth.token.email is string && request.auth.token.email_verified == true && request.auth.token.email.lower() in ['jbutler803@c2ken.net', 'jbutler803@c2kni.net', 'jbutler483@gmail.com']; }
    match /newsletter/{doc} {
      allow read: if true;
      allow write: if nlEditor();
    }
    match /newsletterIssues/{id} {
      allow read: if true;
      allow write: if nlEditor() && request.resource.data.enc is string && request.resource.data.enc.size() < 400000;
      allow delete: if nlEditor();
    }
    match /newsletterImgs/{id} {
      allow read: if true;
      allow write: if nlEditor() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if nlEditor();
    }
    // Anonymous staff usage: one doc per device. Only devices with the staff key (token) can write; only the editor can read the totals.
    match /newsletterVisits/{id} {
      allow get: if true;
      allow list, delete: if nlEditor();
      allow write: if nlEditor();   // lets the editor bring records across from the old project
      allow create: if id.size() <= 40 && request.resource.data.keys().hasOnly(['t','first','last','n','app','mob','name'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.first == request.time
        && request.resource.data.last == request.time && request.resource.data.n == 1
        && request.resource.data.app is bool && request.resource.data.mob is bool
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60));
      allow update: if request.resource.data.keys().hasOnly(['t','first','last','n','app','mob','name'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.first == resource.data.first
        && request.resource.data.last == request.time && request.resource.data.n == resource.data.n + 1
        && request.resource.data.app is bool && request.resource.data.mob is bool
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60));
    }
    // Tip of the day log: one doc per date.
    match /newsletterTipLog/{day} {
      allow read: if true;
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.keys().hasOnly(['id','at','t'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.id is string && request.resource.data.id.size() < 120
        && request.resource.data.at == request.time;
      allow write, delete: if nlEditor();
    }
  }
}
