rules_version = '2';
// ERGS AI – AI in School: A Teacher's Guide (Firebase project: ergs-ai)
service cloud.firestore {
  match /databases/{database}/documents {
    // Content is encrypted with the staff password, so anyone may read; only the editor may write.
    function nlEditor() { return request.auth != null && request.auth.token.email is string && request.auth.token.email_verified == true && request.auth.token.email.lower() in ['jbutler803@c2ken.net', 'jbutler803@c2kni.net', 'jbutler483@gmail.com']; }
    match /newsletter/{doc} {
      allow read: if true;
      allow write: if nlEditor();
    }
    match /newsletterIssues/{id} {
      allow read: if true;
      allow write: if nlEditor() && request.resource.data.enc is string && request.resource.data.enc.size() < 400000;
      allow delete: if nlEditor();
    }
    match /newsletterImgs/{id} {
      allow read: if true;
      allow write: if nlEditor() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if nlEditor();
    }
    // Anonymous staff usage: one doc per device. Only devices with the staff key (token) can write; only the editor can read the totals.
    match /newsletterVisits/{id} {
      allow get: if true;
      allow list, delete: if nlEditor();
      allow write: if nlEditor();   // lets the editor bring records across from the old project
      allow create: if id.size() <= 40 && request.resource.data.keys().hasOnly(['t','first','last','n','app','mob','name'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.first == request.time
        && request.resource.data.last == request.time && request.resource.data.n == 1
        && request.resource.data.app is bool && request.resource.data.mob is bool
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60));
      allow update: if request.resource.data.keys().hasOnly(['t','first','last','n','app','mob','name'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.first == resource.data.first
        && request.resource.data.last == request.time && request.resource.data.n == resource.data.n + 1
        && request.resource.data.app is bool && request.resource.data.mob is bool
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60));
    }
    // "How I used it" one-liners under each issue: text and name are encrypted with the staff key.
    match /newsletterUses/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['issue','enc','t','at'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.issue is string && request.resource.data.issue.size() <= 60
        && request.resource.data.enc is string && request.resource.data.enc.size() < 3000 && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if nlEditor();
    }
    // Tips each device has marked as tried (a count only).
    match /newsletterTried/{id} {
      allow get: if true;
      allow list, delete: if nlEditor();
      allow create, update: if id.size() <= 40 && request.resource.data.keys().hasOnly(['t','c','at'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.c is int
        && request.resource.data.c >= 0 && request.resource.data.c < 5000 && request.resource.data.at == request.time;
    }
    // "Did it work?" ratings on prompts: one doc per device per prompt.
    match /newsletterRatings/{id} {
      allow read: if true;
      allow delete: if nlEditor();
      allow create, update: if id.size() <= 160 && request.resource.data.keys().hasOnly(['t','p','v','at'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.p is string && request.resource.data.p.size() <= 120
        && (request.resource.data.v == 1 || request.resource.data.v == -1) && request.resource.data.at == request.time;
    }
    // Prompts shared by staff (encrypted with the staff key). They go live straight away; the editor can take them down.
    match /newsletterShared/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['enc','t','st','at'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.st in ['pending', 'live']
        && request.resource.data.enc is string && request.resource.data.enc.size() < 12000 && request.resource.data.at == request.time;
      allow update, delete: if nlEditor();
    }
    // The editor's edits to library prompts (encrypted), applied for everyone; only the editor can write.
    match /newsletterPromptEdits/{id} {
      allow read: if true;
      allow write, delete: if nlEditor() && (request.resource == null || (request.resource.data.enc is string && request.resource.data.enc.size() < 20000));
    }
    // Push notification subscriptions (one per device). Readable so the GitHub Action can send; only a push key, no personal data.
    match /newsletterPush/{id} {
      allow read: if true;
      allow create, update: if id.size() <= 48 && request.resource.data.keys().hasOnly(['t','sub','at','off'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.sub is string && request.resource.data.sub.size() < 2000
        && request.resource.data.off is bool && request.resource.data.at == request.time;
      allow delete: if nlEditor();
    }
    // Tip of the day log: one doc per date.
    match /newsletterTipLog/{day} {
      allow read: if true;
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.keys().hasOnly(['id','at','t'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.id is string && request.resource.data.id.size() < 120
        && request.resource.data.at == request.time;
      allow write, delete: if nlEditor();
    }
  }
}
